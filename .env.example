# Токен от @BotFather. В чат его не вставляйте.
BOT_TOKEN=

# Ваш Telegram user_id (узнать: /id у @userinfobot). Можно несколько через запятую.
ADMIN_IDS=

# --- Экономика (виртуальные монеты) ---
START_BALANCE=1000
DAILY_BONUS=250
BONUS_COOLDOWN_HOURS=24
MIN_BET=10
# экспрессы
MAX_EXPRESS_LEGS=6
MAX_EXPRESS_ODDS=40
CURRENCY=🪙

# --- Реальная линия Fonbet ---
FONBET_BASE_URL=https://line-lb51.bk6bba-resources.com
FONBET_SCOPE_MARKET=1600

# Тир-1: белый список брендов турниров (подстрока в названии, регистр не важен)
TIER1_INCLUDE=IEM,ESL Pro League,ESL One,BLAST Premier,BLAST Rivals,BLAST Bounty,BLAST Open,PGL,Major,World Cup,Thunderpick World Championship
# Мусор, который не пускаем даже из «своих» турниров
TIER1_EXCLUDE=Qualifier,Квалификац,Отбор,Academy,Women,Женск,H2H,1x1,2x2,3x3,Showmatch,Клуб,1х1,2х2,CCT

# real — кэфы как у букмекера (с маржой), fair — маржа убирается
ODDS_MODE=real
# как часто обновлять линию, сек
SYNC_INTERVAL=90
# автопост новых матчей в групповые чаты
AUTOPOST_MATCHES=true
AUTOPOST_LIMIT=3
AUTOPOST_HORIZON_HOURS=24
# через сколько минут после старта добиваться результата
RESULT_CHECK_AFTER_MINUTES=45

# --- Режим запуска ---
# polling — для локального запуска и VPS
# webhook — для бесплатных PaaS (Render, Koyeb и т.п.)
RUN_MODE=polling

# Заполняется только для webhook:
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
# сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=

# Порт HTTP-сервера (в облаке обычно задаётся платформой)
PORT=8080

# --- Прочее ---
DB_PATH=data/bot.db
THROTTLE_SECONDS=0.4

# Таймаут long polling, сек. Держите <=10, если бот за NAT/прокси или на слабом канале:
# при 30 сек «подвисшие» соединения могут тихо съедать апдейты.
POLLING_TIMEOUT=10

# true — при рестарте выбросить накопившиеся сообщения (по умолчанию обрабатываем их)
DROP_PENDING_UPDATES=false

LOG_LEVEL=INFO

# --- Мини-приложение (Telegram WebApp) ---
# Публичный https-адрес сервиса (python miniapp.py). Если пусто — кнопка в меню не показывается.
MINIAPP_URL=
MINIAPP_PORT=8081
# Только для локальной отладки в браузере: id игрока, который «авторизован» без Telegram
MINIAPP_DEV_USER=0

# --- База данных ---
# Пусто → локальный SQLite (DB_PATH). Для хостинга: строка подключения Neon/Supabase,
# например postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Если задан ненулевой ID приватного канала, SQLite восстанавливается из закреплённого снимка Telegram,
# а после каждого commit снимок обновляется. Этот режим заменяет DATABASE_URL.
TELEGRAM_DB_CHAT_ID=0
